// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Skema adalah kontrak (PRD §7.1). Perubahan lewat PR terpisah.
// Semua id = cuid(); uang & berat = Decimal; tidak ada onDelete: Cascade
// pada tabel transaksi (BR-10); FK sering di-query punya @@index.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PETUGAS
}

enum StatusDispatch {
  DRAFT
  DISPATCHED
  DITERIMA
  DITOLAK
  SERAH_TERIMA
  SELESAI
  DIBATALKAN
}

enum TipeMutasi {
  MASUK
  KELUAR
  ADJUST
}

// FR-E5. Dua pemicu yang ditetapkan PRD: stock melewati threshold saat setoran
// selesai (§4.1 langkah 16, AC baris 313) dan dispatch masuk ke petugas pemilik
// (diagram urutan §6).
enum TipeNotifikasi {
  STOCK_THRESHOLD
  DISPATCH_MASUK
}

enum KondisiSampah {
  BERSIH
  KOTOR
  CAMPUR
}

/// Alasan penolakan gerbang kualitas — FR-C2, PRD §4.1 langkah 5.
/// LAINNYA mewajibkan `catatan` diisi (dijaga zod + CHECK di migration).
enum AlasanTolak {
  TIDAK_TERSORTIR // masih campur, belum dipisah per jenis
  TIDAK_SESUAI_MASTER // jenisnya tidak ada di master JenisSampah
  TERKONTAMINASI // basah, berminyak, bercampur sisa makanan
  LAINNYA
}

model Kelurahan {
  id          String      @id @default(cuid())
  nama        String
  kodeWilayah String      @unique
  bankSampah  BankSampah?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime? // soft delete (BR-17)

  @@map("kelurahan")
}

model BankSampah {
  id          String       @id @default(cuid())
  nama        String
  kelurahanId String       @unique // BR-01: 1 kelurahan = 1 bank sampah
  kelurahan   Kelurahan    @relation(fields: [kelurahanId], references: [id])
  alamat      String
  latitude    Decimal      @db.Decimal(10, 7)
  longitude   Decimal      @db.Decimal(10, 7)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime? // soft delete (BR-17)
  petugas     User[]
  nasabah     Nasabah[]
  setoran     Setoran[]
  stock       Stock[]
  dispatch    Dispatch[]
  notifikasi  Notifikasi[]

  @@map("bank_sampah")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  nama           String
  noHp           String? // jangkar penautan akun warga ke Nasabah (dicocokkan per bank sampah)
  role           Role
  bankSampahId   String? // wajib kalau PETUGAS (BR-02)
  bankSampah     BankSampah?     @relation(fields: [bankSampahId], references: [id])
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime? // soft delete (BR-17)
  credential     Credential?
  setoranDicatat Setoran[]       @relation("PetugasSetoran")
  dispatchDibuat Dispatch[]      @relation("AdminDispatch")
  mutasiStock    StockMutation[]
  koreksiStock   KoreksiStock[]  @relation("PelakuKoreksi")
  auditLog       AuditLog[]
  notifikasi     Notifikasi[]
  fotoDiunggah   FotoBukti[]

  @@index([bankSampahId])
  @@map("user")
}

model Credential {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft delete (BR-17)

  @@map("credential")
}

model Nasabah {
  id           String     @id @default(cuid())
  kodeNasabah  String     @unique
  bankSampahId String
  bankSampah   BankSampah @relation(fields: [bankSampahId], references: [id])
  nama         String
  noHp         String?
  alamat       String
  rt           String
  rw           String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime? // soft delete (BR-17)
  setoran      Setoran[]

  @@index([bankSampahId])
  @@map("nasabah")
}

model JenisSampah {
  id             String           @id @default(cuid())
  kode           Int              @unique
  nama           String
  kategori       String           @default("PLASTIK")
  satuan         String           @default("KG")
  harga          Decimal          @default(0) @db.Decimal(14, 2) // harga beli/jual tunggal (flatten dari HargaSampah)
  deskripsi      String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime? // soft delete (BR-17)
  setoranItem    SetoranItem[]
  setoranDitolak SetoranDitolak[]
  dispatchItem   DispatchItem[]
  stock          Stock[]

  @@map("jenis_sampah")
}

model Pembeli {
  id         String     @id @default(cuid())
  nama       String
  perusahaan String?
  noHp       String
  alamat     String
  catatan    String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime? // soft delete (BR-17)
  dispatch   Dispatch[]

  @@map("pembeli")
}

model Setoran {
  id             String           @id @default(cuid())
  kodeTransaksi  String           @unique
  bankSampahId   String
  bankSampah     BankSampah       @relation(fields: [bankSampahId], references: [id])
  nasabahId      String
  nasabah        Nasabah          @relation(fields: [nasabahId], references: [id])
  petugasId      String
  petugas        User             @relation("PetugasSetoran", fields: [petugasId], references: [id])
  totalBerat     Decimal          @db.Decimal(10, 2)
  totalNilai     Decimal          @db.Decimal(14, 2)
  cashDibayar    Boolean          @default(false) // BR-04: tunai di luar sistem
  tanggal        DateTime
  idempotencyKey String           @unique
  createdAt      DateTime         @default(now())
  items          SetoranItem[]
  ditolak        SetoranDitolak[]

  @@index([bankSampahId, tanggal])
  @@map("setoran")
}

model SetoranItem {
  id            String        @id @default(cuid())
  setoranId     String
  setoran       Setoran       @relation(fields: [setoranId], references: [id])
  jenisSampahId String
  jenisSampah   JenisSampah   @relation(fields: [jenisSampahId], references: [id])
  berat         Decimal       @db.Decimal(10, 2)
  hargaSaatItu  Decimal       @db.Decimal(14, 2) // BR-09: snapshot, bukan relasi
  subtotal      Decimal       @db.Decimal(14, 2)
  kondisi       KondisiSampah

  @@index([setoranId])
  @@map("setoran_item")
}

/// Barang yang DITOLAK gerbang kualitas — FR-C2, BR-18.
///
/// Sengaja tabel TERPISAH dari SetoranItem, bukan kolom status di dalamnya.
/// Barang tolakan dikembalikan ke warga dan tidak pernah menjadi milik bank
/// sampah, jadi ia tidak boleh bisa masuk ke stock, pembayaran, atau laporan
/// volume — dan dengan bentuk ini ia TIDAK BISA, bahkan kalau suatu saat ada
/// query yang lupa memasang filter. Invarian "totalBerat = jumlah SetoranItem"
/// pun tetap utuh.
model SetoranDitolak {
  id        String  @id @default(cuid())
  setoranId String
  setoran   Setoran @relation(fields: [setoranId], references: [id])

  /// null kalau barangnya tidak cocok dengan master jenis mana pun — justru
  /// itu salah satu alasan penolakan (TIDAK_SESUAI_MASTER).
  jenisSampahId String?
  jenisSampah   JenisSampah? @relation(fields: [jenisSampahId], references: [id])

  /// Apa yang ditolak, dengan kata-kata petugas. Selalu diisi, karena inilah
  /// catatan yang berguna saat penolakan ditinjau kemudian.
  deskripsi String
  berat     Decimal     @db.Decimal(10, 2) // BR-08; > 0, tidak masuk stock
  alasan    AlasanTolak
  catatan   String? // wajib kalau alasan = LAINNYA
  createdAt DateTime    @default(now())

  @@index([setoranId])
  @@map("setoran_ditolak")
}

model Stock {
  id             String          @id @default(cuid())
  bankSampahId   String
  bankSampah     BankSampah      @relation(fields: [bankSampahId], references: [id])
  jenisSampahId  String
  jenisSampah    JenisSampah     @relation(fields: [jenisSampahId], references: [id])
  berat          Decimal         @default(0) @db.Decimal(10, 2) // BR-07: CHECK (berat >= 0) di migration
  beratReservasi Decimal         @default(0) @db.Decimal(10, 2)
  threshold      Decimal         @default(0) @db.Decimal(10, 2)
  updatedAt      DateTime        @updatedAt
  mutasi         StockMutation[]
  koreksi        KoreksiStock[]

  @@unique([bankSampahId, jenisSampahId])
  @@map("stock")
}

model StockMutation {
  id           String     @id @default(cuid())
  stockId      String
  stock        Stock      @relation(fields: [stockId], references: [id])
  tipe         TipeMutasi
  berat        Decimal    @db.Decimal(10, 2)
  beratSebelum Decimal    @db.Decimal(10, 2)
  beratSesudah Decimal    @db.Decimal(10, 2)
  refType      String
  refId        String
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  keterangan   String?
  createdAt    DateTime   @default(now())

  @@index([stockId, createdAt])
  @@map("stock_mutation")
}

model KoreksiStock {
  id              String   @id @default(cuid())
  stockId         String
  stock           Stock    @relation(fields: [stockId], references: [id])
  beratSebelum    Decimal  @db.Decimal(10, 2)
  beratSesudah    Decimal  @db.Decimal(10, 2)
  alasan          String
  dilakukanOlehId String
  dilakukanOleh   User     @relation("PelakuKoreksi", fields: [dilakukanOlehId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stockId])
  @@map("koreksi_stock")
}

model Dispatch {
  id                String         @id @default(cuid())
  kodeDispatch      String         @unique
  bankSampahId      String
  bankSampah        BankSampah     @relation(fields: [bankSampahId], references: [id])
  pembeliId         String
  pembeli           Pembeli        @relation(fields: [pembeliId], references: [id])
  dibuatOlehId      String
  dibuatOleh        User           @relation("AdminDispatch", fields: [dibuatOlehId], references: [id])
  status            StatusDispatch @default(DRAFT)
  tanggalJemput     DateTime
  totalNilai        Decimal?       @db.Decimal(14, 2)
  alasanTolak       String?
  alasanSelisih     String?
  selisihSignifikan Boolean        @default(false)
  fotoBuktiUrl      String? // diisi rute /api/dispatch/[id]/foto saat foto ada
  fotoBukti         FotoBukti?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime? // soft delete — admin dapat hapus dispatch (diperbolehkan, BR-10 revisi)
  items             DispatchItem[]

  @@index([bankSampahId, status])
  @@index([bankSampahId, deletedAt])
  @@map("dispatch")
}

model DispatchItem {
  id             String      @id @default(cuid())
  dispatchId     String
  dispatch       Dispatch    @relation(fields: [dispatchId], references: [id])
  jenisSampahId  String
  jenisSampah    JenisSampah @relation(fields: [jenisSampahId], references: [id])
  beratTarget    Decimal     @db.Decimal(10, 2)
  beratAktual    Decimal?    @db.Decimal(10, 2)
  hargaJualPerKg Decimal     @db.Decimal(14, 2)
  subtotal       Decimal?    @db.Decimal(14, 2)

  @@index([dispatchId])
  @@map("dispatch_item")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  aksi          String
  entitas       String
  entitasId     String
  payloadBefore Json?
  payloadAfter  Json?
  createdAt     DateTime @default(now())

  @@index([entitas, entitasId])
  @@index([userId, createdAt])
  @@map("audit_log")
}

/// Notifikasi in-app — FR-E5.
///
/// Satu baris PER PENERIMA, bukan satu baris dibagi banyak orang. PRD menyebut
/// penerimanya sebagai peran ("notifikasi ke Admin", "push notif ke petugas
/// pemilik"), bukan satu akun; kalau barisnya dibagi, `dibacaPada` jadi ambigu —
/// satu admin membaca dan notifikasi itu hilang untuk admin lain. Penerima
/// karena itu diselesaikan saat penulisan, dan status baca selalu milik satu
/// akun.
///
/// PRD §4.2 (Arsitektur): tidak ada message broker; notifikasi disimpan di DB
/// lalu ditarik aplikasi, tanpa cron (BR-06).
model Notifikasi {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tipe   TipeNotifikasi
  judul  String
  pesan  String
  /// Rute in-app yang dituju saat notifikasi diklik, mis. /admin/peta.
  tautan String?

  /// Konteks bank sampah; null untuk notifikasi yang tidak terikat satu pos.
  bankSampahId String?
  bankSampah   BankSampah? @relation(fields: [bankSampahId], references: [id])

  dibacaPada DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // soft delete (BR-17)

  /// Daftar notifikasi selalu diambil per user, terbaru dulu, dan jumlah yang
  /// belum dibaca dihitung dari indeks yang sama.
  @@index([userId, dibacaPada, createdAt])
  @@index([bankSampahId])
  @@map("notifikasi")
}

/// Foto bukti serah terima dispatch — FR-D5, BR-19.
///
/// Isinya disimpan di Postgres, bukan di filesystem: Vercel serverless tidak
/// punya penyimpanan persisten, dan §8.1 melarang menambah dependency besar
/// seperti SDK object storage. Postgres sudah ada, jadi tidak ada infrastruktur
/// baru yang harus disiapkan tim maupun di-deploy.
///
/// Unggahnya SENGAJA endpoint terpisah, bukan dibundel ke serah-terima:
/// petugas bekerja dari HP di lapangan, dan menyandera perpindahan status pada
/// unggahan 1 MB yang bisa gagal akan membuat barang yang sudah fisik berpindah
/// tidak tercatat. Foto boleh menyusul selama dispatch masih DITERIMA atau
/// SERAH_TERIMA; setelah SELESAI ia terkunci mengikuti BR-13.
///
/// Barisnya dipisah dari Dispatch supaya kolom Bytes yang besar tidak ikut
/// terbaca setiap kali dispatch di-query; hanya rute foto yang menyentuhnya.
model FotoBukti {
  id         String   @id @default(cuid())
  dispatchId String   @unique // satu foto per dispatch (FR-D5)
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id])

  mimeType String // dibatasi image/jpeg | image/png | image/webp
  ukuran   Int // byte; batas di src/lib/constants.ts
  data     Bytes

  diunggahOlehId String
  diunggahOleh   User     @relation(fields: [diunggahOlehId], references: [id])
  createdAt      DateTime @default(now())

  @@index([diunggahOlehId])
  @@map("foto_bukti")
}
